.row button {
  margin-top: 12rpx;
}

.small-input {
  width: 180rpx;
  min-height: 56rpx;
}

.table-image {
  width: 100%;
  height: 220rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  background: #f3f3f3;
}

.qr-image {
  width: 320rpx;
  height: 320rpx;
  display: block;
  margin: 12rpx 0;
  border: 1rpx solid #d8ded6;
  border-radius: 8rpx;
  background: #ffffff;
}

.qr-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}

.qr-thumb {
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid #d8ded6;
  border-radius: 8rpx;
  background: #ffffff;
}

.checkin-calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin: 12rpx 0;
}

.checkin-day {
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #eef1ec;
  color: #5e6a61;
  font-size: 22rpx;
}

.checkin-day.signed {
  background: #0f7b59;
  color: #ffffff;
}

.checkin-day.today {
  border: 2rpx solid #d6a642;
  line-height: 44rpx;
}
