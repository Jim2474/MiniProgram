<view class="page">
  <view class="hero">
    <view class="eyebrow">CUSTOMER ORDER</view>
    <view class="title">扫码点单与会员权益</view>
    <view class="subtitle">扫码员工二维码后点单，微信支付成功自动扣库存、发积分并归属业绩。</view>
  </view>

  <view class="section">
    <view class="section-title">个人中心</view>
    <view class="metrics">
      <view class="metric">
        <view class="metric-value">{{profile.user.nickname || '未登录'}}</view>
        <view class="metric-label">微信昵称</view>
      </view>
      <view class="metric">
        <view class="metric-value">{{profile.user.phone || '待绑定'}}</view>
        <view class="metric-label">手机号</view>
      </view>
    </view>
    <view class="row">
      <view class="row-title">当前会员 {{currentUserId}}</view>
      <view class="muted">头像 {{profile.user.avatar || '默认头像'}} · 等级 {{profile.levelName}}</view>
      <input class="input" value="{{loginPhone}}" bindinput="onLoginPhone" placeholder="登录手机号" />
      <input class="input" value="{{loginNickname}}" bindinput="onLoginNickname" placeholder="微信昵称" />
      <input class="input" value="{{bindPhoneValue}}" bindinput="onBindPhone" placeholder="绑定手机号" />
      <view class="btn-row">
        <button size="mini" class="primary" bindtap="loginCustomer">微信登录/切换会员</button>
        <button size="mini" class="secondary" open-type="getPhoneNumber" bindgetphonenumber="bindWechatPhone">微信授权手机号</button>
        <button size="mini" class="secondary" bindtap="bindPhone">手动绑定</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">扫码员工</view>
    <view class="input">{{selectedEmployee.name ? '已绑定员工：' + selectedEmployee.name : '未扫码，订单不归属员工'}}</view>
    <view class="btn-row">
      <button class="primary" bindtap="scanEmployeeCode">扫码员工二维码</button>
    </view>
    <view class="muted" wx:if="{{scanText}}">{{scanText}}</view>
  </view>

  <view class="section">
    <view class="section-title">商品</view>
    <view wx:for="{{products}}" wx:key="skuId" class="row">
      <view class="row-title">{{item.name}}</view>
      <view class="muted">{{item.spec}} · {{item.description}}</view>
      <view>
        <text class="tag">{{item.priceText}}</text>
        <text class="tag {{item.lowStock ? 'danger' : ''}}">库存 {{item.stockQty}}</text>
      </view>
      <view class="btn-row">
        <button size="mini" class="secondary" data-sku="{{item.skuId}}" bindtap="showProductDetail">查看详情</button>
        <button size="mini" class="primary" data-sku="{{item.skuId}}" bindtap="addToCart">加入购物车</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">购物车</view>
    <view wx:if="{{cartItems.length === 0}}" class="muted">购物车为空。</view>
    <view wx:for="{{cartItems}}" wx:key="cartItemId" class="row">
      <view class="row-title">{{item.product.name}} x {{item.quantity}}</view>
      <view class="muted">{{item.product.spec}} · {{item.subtotalText}}</view>
      <button size="mini" class="secondary" data-id="{{item.cartItemId}}" bindtap="removeCartItem">删除</button>
    </view>
    <view class="row">
      <view class="row-title">合计：{{cartTotalText}}</view>
      <view class="muted">预计赠送 {{cartTotal}} 积分</view>
    </view>
    <view class="btn-row">
      <button class="primary" bindtap="createOrder">创建订单</button>
      <button class="dark" disabled="{{!currentOrder}}" bindtap="payOrder">微信支付</button>
    </view>
    <view class="muted" wx:if="{{resultText}}">{{resultText}}</view>
  </view>

  <view class="section">
    <view class="section-title">今日订单</view>
    <view wx:if="{{todayOrders.length === 0}}" class="muted">今日暂无订单。</view>
    <view wx:for="{{todayOrders}}" wx:key="orderId" class="row">
      <view class="row-title">{{item.orderId}}</view>
      <view class="muted">{{item.statusText}} · {{item.amountText}} · 赠送 {{item.pointsAwardedText}} · {{item.employeeName}} · {{item.orderDate}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">历史订单</view>
    <view wx:if="{{historyOrders.length === 0}}" class="muted">暂无历史订单。</view>
    <view wx:for="{{historyOrders}}" wx:key="orderId" class="row">
      <view class="row-title">{{item.orderId}}</view>
      <view class="muted">{{item.statusText}} · {{item.amountText}} · 赠送 {{item.pointsAwardedText}} · {{item.employeeName}} · {{item.orderDate}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">积分与存酒</view>
    <view class="metrics">
      <view class="metric">
        <view class="metric-value">{{points.balance}}</view>
        <view class="metric-label">当前积分</view>
      </view>
      <view class="metric">
        <view class="metric-value">{{storage.length}}</view>
        <view class="metric-label">存酒记录</view>
      </view>
    </view>
    <view wx:for="{{storage}}" wx:key="storageId" class="row">
      <view class="row-title">{{item.product.name}} · {{item.quantity}}{{item.product.unit}}</view>
      <view class="muted">{{item.statusText}} · 到期 {{item.expireDate}}</view>
      <view wx:if="{{item.status === 'available' && item.quantity > 0}}" class="btn-row">
        <input class="input small-input" type="number" value="{{pickupQty}}" bindinput="onPickupQty" placeholder="取酒数量" />
        <button size="mini" class="primary" data-id="{{item.storageId}}" bindtap="requestPickup">申请取酒</button>
        <button size="mini" class="secondary" data-type="storage" bindtap="createQrCode">生成取酒二维码</button>
      </view>
      <view wx:if="{{item.status === 'available' && item.quantity > 0}}" class="muted">可申请 1-{{item.quantity}}{{item.product.unit}}</view>
    </view>
    <view class="row">
      <view class="row-title">积分明细</view>
      <button size="mini" class="secondary" data-type="points" bindtap="createQrCode">生成取积分二维码</button>
      <view wx:for="{{points.ledgers}}" wx:key="ledgerId" class="muted">{{item.reason}} · {{item.changeAmount}} · 余额 {{item.balanceAfter}}</view>
    </view>
    <view class="row">
      <view class="row-title">历史存取记录</view>
      <view wx:if="{{storageLedgers.length === 0}}" class="muted">暂无存取记录。</view>
      <view wx:for="{{storageLedgers}}" wx:key="ledgerId" class="muted">{{item.recordDate}} · {{item.productName}} · {{item.actionType}} · {{item.changeQty}} · 余量 {{item.quantityAfter}}</view>
    </view>
    <view class="row">
      <view class="row-title">取酒申请记录</view>
      <view wx:if="{{pickupRecords.length === 0}}" class="muted">暂无取酒申请。</view>
      <view wx:for="{{pickupRecords}}" wx:key="requestId" class="muted">{{item.requestDate}} · {{item.statusText}} · 数量 {{item.quantity}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">会员营销</view>
    <view class="metrics">
      <view class="metric">
        <view class="metric-value">{{profile.levelName}}</view>
        <view class="metric-label">会员等级</view>
      </view>
    </view>
    <view class="btn-row">
      <button size="mini" class="primary" bindtap="checkin">签到送积分</button>
    </view>
    <view class="row">
      <view class="row-title">签到记录</view>
      <view class="checkin-calendar">
        <view wx:for="{{checkinCalendar}}" wx:key="date" class="checkin-day {{item.signed ? 'signed' : ''}} {{item.isToday ? 'today' : ''}}">{{item.day}}</view>
      </view>
      <view wx:for="{{checkinRecords}}" wx:key="checkinId" class="muted">{{item.date}} · +{{item.points}}</view>
    </view>
    <view class="row">
      <view class="row-title">核销二维码</view>
      <image wx:if="{{qrImageUrl}}" class="qr-image" mode="aspectFit" src="{{qrImageUrl}}" />
      <view class="muted" wx:if="{{qrText}}">当前码值：{{qrText}}</view>
      <view wx:for="{{verificationCodes}}" wx:key="codeId" class="qr-row">
        <image wx:if="{{item.qrImageUrl}}" class="qr-thumb" mode="aspectFit" src="{{item.qrImageUrl}}" />
        <view class="muted">{{item.type}} · {{item.qrPayload}} · {{item.statusText}}</view>
      </view>
    </view>
    <view class="row">
      <view class="row-title">门店服务</view>
      <view class="muted">{{storeLocation.address}} · 客服 {{supportPhone}}</view>
      <view class="btn-row">
        <button size="mini" class="secondary" bindtap="openStoreLocation">打开地图</button>
        <button size="mini" class="secondary" bindtap="callSupport">拨打客服</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">桌位预约</view>
    <view class="row">
      <view class="row-title">预约申请信息</view>
      <picker mode="date" value="{{reservationDate}}" bindchange="onReservationDate">
        <view class="input">日期：{{reservationDate}}</view>
      </picker>
      <picker mode="time" value="{{reservationClock}}" bindchange="onReservationClock">
        <view class="input">时间：{{reservationClock}}</view>
      </picker>
      <input class="input" type="number" value="{{reservationPartySize}}" bindinput="onReservationPartySize" placeholder="预约人数" />
      <input class="input" value="{{reservationRemark}}" bindinput="onReservationRemark" placeholder="备注" />
    </view>
    <view wx:for="{{tables}}" wx:key="tableId" class="row">
      <image wx:if="{{item.imageUrl}}" mode="aspectFill" src="{{item.imageUrl}}" class="table-image" />
      <view class="row-title">{{item.name}} · {{item.capacity}}人</view>
      <view class="muted">{{item.type}} · {{item.statusText}}</view>
      <button size="mini" class="secondary" data-id="{{item.tableId}}" bindtap="createReservation">提交预约</button>
    </view>
    <view wx:for="{{reservations}}" wx:key="reservationId" class="row">
      <view class="row-title">{{item.table.name}} · {{item.reservationDate}}</view>
      <view class="muted">{{item.statusText}} · {{item.partySize || 1}}人 · {{item.contactPhone}} · {{item.remark}}</view>
      <button wx:if="{{item.status === 'pending' || item.status === 'confirmed'}}" size="mini" class="secondary" data-id="{{item.reservationId}}" bindtap="cancelReservation">取消预约</button>
    </view>
  </view>
</view>
