.btn-row button {
  margin-bottom: 8rpx;
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.seat {
  border: 1rpx solid #d8ded6;
  border-radius: 12rpx;
  padding: 12rpx;
}

.blind-logo {
  width: 220rpx;
  height: 96rpx;
  display: block;
  margin-bottom: 12rpx;
}

.blind-stage {
  border: 0;
  border-radius: 12rpx;
  padding: 24rpx;
  overflow: hidden;
}

.blind-title {
  line-height: 1.2;
}

.blind-stage-muted {
  color: inherit;
  opacity: .88;
}

.blind-timer {
  margin-top: 16rpx;
  font-weight: 700;
}

.blind-live-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.blind-meta-item {
  min-width: 180rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: #eef6f1;
  color: #1d3a2a;
  font-size: 24rpx;
}

.champion-panel {
  margin-top: 12rpx;
  border: 1rpx solid #d8ded6;
  border-radius: 12rpx;
  overflow: hidden;
  background: #111827;
  color: #f8d66d;
}

.champion-image {
  width: 100%;
  height: 180rpx;
  display: block;
}

.champion-copy {
  padding: 12rpx;
  font-size: 24rpx;
  word-break: break-all;
}
