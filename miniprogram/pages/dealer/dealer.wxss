.btn-row button {
  margin-bottom: 8rpx;
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.seat {
  border: 1rpx solid #d8ded6;
  border-radius: 12rpx;
  padding: 12rpx;
}

.blind-logo {
  width: 220rpx;
  height: 96rpx;
  display: block;
  margin-bottom: 12rpx;
}

.champion-panel {
  margin-top: 12rpx;
  border: 1rpx solid #d8ded6;
  border-radius: 12rpx;
  overflow: hidden;
  background: #111827;
  color: #f8d66d;
}

.champion-image {
  width: 100%;
  height: 180rpx;
  display: block;
}

.champion-copy {
  padding: 12rpx;
  font-size: 24rpx;
  word-break: break-all;
}
