<view class="page">
  <view class="hero">
    <view class="eyebrow">BLIND TIMER</view>
    <view class="title">荷官轻量升盲系统</view>
    <view class="subtitle">创建牌局后可升盲、降盲、暂停、淘汰、恢复和统计代入。</view>
  </view>

  <view class="section">
    <view class="section-title">创建本局</view>
    <input class="input" type="number" value="{{form.smallBlind}}" data-key="smallBlind" bindinput="onInput" placeholder="小盲" />
    <input class="input" type="number" value="{{form.bigBlind}}" data-key="bigBlind" bindinput="onInput" placeholder="大盲" />
    <picker mode="selector" range="{{intervalOptions}}" value="{{form.intervalIndex}}" bindchange="onIntervalChange">
      <view class="input">升盲间隔：{{form.intervalMinutes}} 分钟</view>
    </picker>
    <input class="input" type="number" value="{{form.initialPlayers}}" data-key="initialPlayers" bindinput="onInput" placeholder="初始人数" />
    <input class="input" type="number" value="{{form.buyinAmount}}" data-key="buyinAmount" bindinput="onInput" placeholder="单手买入金额" />
    <switch checked="{{form.voiceEnabled}}" bindchange="onVoiceEnabledChange" /> 语音提醒
    <button class="primary" bindtap="createGame">开始本局</button>
  </view>

  <view class="section">
    <view class="section-title">游戏进行中</view>
    <view wx:if="{{!game}}" class="muted">暂无游戏，先创建一局。</view>
    <view wx:if="{{game}}" class="row">
      <view class="row-title">Level {{game.level}} · {{game.smallBlind}}/{{game.bigBlind}}</view>
      <view class="muted">{{game.statusText}} · 剩余 {{game.currentPlayers}}/{{game.initialPlayers}} 人{{game.headsUpText}}{{game.championText}}</view>
      <view wx:if="{{game.isChampion}}" class="champion-panel">
        <image wx:if="{{blindSettings.championBackgroundImage}}" class="champion-image" src="{{blindSettings.championBackgroundImage}}" mode="aspectFill" />
        <view class="champion-copy">冠军背景 {{blindSettings.championBackgroundImage || '未配置'}}</view>
      </view>
      <view class="muted" wx:if="{{timer}}">倒计时 {{timer.remainingText}}</view>
      <view class="muted">代入 {{game.buyinCount}} 手 · 总代入 {{game.buyinTotalText}}</view>
      <view class="btn-row">
        <button size="mini" class="primary" bindtap="loadTimer">刷新计时</button>
        <button size="mini" class="secondary" data-action="pause" bindtap="gameAction">暂停</button>
        <button size="mini" class="secondary" data-action="resume" bindtap="gameAction">继续</button>
        <button size="mini" class="primary" data-action="next_level" bindtap="gameAction">升盲</button>
        <button size="mini" class="secondary" data-action="prev_level" bindtap="gameAction">降盲</button>
        <button size="mini" class="secondary" data-action="eliminate" bindtap="gameAction">淘汰</button>
        <button size="mini" class="secondary" data-action="restore" bindtap="gameAction">恢复</button>
        <button size="mini" class="secondary" data-action="buyin" bindtap="gameAction">+1手</button>
        <button size="mini" class="secondary" data-action="buyin_minus" bindtap="gameAction">-1手</button>
        <button size="mini" class="secondary" data-action="set_buyin_amount" bindtap="gameAction">同步买入金额</button>
        <button size="mini" class="dark" data-action="reset" bindtap="gameAction">重开</button>
      </view>
      <view wx:for="{{voiceEvents}}" wx:key="eventId" class="muted">{{item.eventType}} · {{item.message}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">后台升盲配置</view>
    <view class="row">
      <view class="row-title">主题 {{blindSettings.theme}} · 字号 {{blindSettings.fontSize}} · 字体 {{blindSettings.fontFamily}}</view>
      <view class="muted">报名状态 {{blindSettings.registrationStatus}} · 北京时间 {{blindSettings.showBeijingTime}} · 自动开赛 {{blindSettings.autoStartAfterCountdown}}</view>
      <view class="muted">字体 {{blindSettings.fontColor}} · 计时 {{blindSettings.timerColor}} · 休息 {{blindSettings.breakColor}} · 弹窗 {{blindSettings.dialogColor}}</view>
      <view class="muted">背景 {{blindSettings.backgroundImage || '未配置'}} · Logo {{blindSettings.logo || '未配置'}} · 冠军背景 {{blindSettings.championBackgroundImage || '未配置'}}</view>
    </view>
    <view class="row">
      <view class="row-title">名词</view>
      <view class="muted">级别 {{blindSettings.titleMap.level}} · 剩余人数 {{blindSettings.titleMap.playerLeft}} · 参赛 {{blindSettings.titleMap.entrants}} · 奖励人数 {{blindSettings.titleMap.prizePlayer}}</view>
      <view class="muted">盲注 {{blindSettings.titleMap.blinds}} · 前注 {{blindSettings.titleMap.ante}} · 下一级 {{blindSettings.titleMap.nextLevel}} · 下次休息 {{blindSettings.titleMap.nextBreak}}</view>
      <view class="muted">平均记分牌 {{blindSettings.titleMap.avgChips}} · 总记分牌 {{blindSettings.titleMap.totalChips}}</view>
      <view class="muted">升盲规则 {{blindSettings.blindLevelsText}}</view>
      <view class="muted">语音 {{blindSettings.voiceType}} · 开始 {{blindSettings.voiceStartText}} · 结束 {{blindSettings.voiceEndText}}</view>
      <view class="muted">术语 {{blindSettings.voiceTerms.smallBlind}}/{{blindSettings.voiceTerms.bigBlind}}/{{blindSettings.voiceTerms.ante}} · 参赛 {{blindSettings.entrants}} · 总买入 {{blindSettings.totalBuyins}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">座位状态</view>
    <view class="seat-grid">
      <view wx:for="{{seats}}" wx:key="seatNo" class="seat">
        <view class="row-title">{{item.seatNo}}号位</view>
        <view class="muted">{{item.statusText}}</view>
        <view class="btn-row">
          <button size="mini" data-seat="{{item.seatNo}}" data-action="eliminate" bindtap="gameSeatAction">淘汰</button>
          <button size="mini" data-seat="{{item.seatNo}}" data-action="restore" bindtap="gameSeatAction">恢复</button>
        </view>
      </view>
    </view>
  </view>
</view>
