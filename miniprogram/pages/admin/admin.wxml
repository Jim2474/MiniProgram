<view class="page">
  <view class="hero">
    <view class="eyebrow">ADMIN</view>
    <view class="title">商家经营后台</view>
    <view class="subtitle">订单、库存、存酒、预约、员工业绩与操作日志集中管理。</view>
  </view>

  <view class="section">
    <view class="section-title">管理员登录</view>
    <input class="input" value="{{loginAccount}}" bindinput="onLoginAccount" placeholder="管理员账号" />
    <input class="input" password="true" value="{{loginPassword}}" bindinput="onLoginPassword" placeholder="密码" />
    <button size="mini" class="primary" bindtap="adminLogin">登录后台</button>
    <view wx:if="{{loginSession}}" class="muted">已登录后台会话 {{loginSession.sessionId}}</view>
  </view>

  <view class="metrics">
    <view class="metric"><view class="metric-value">{{dashboard.todayRevenueText}}</view><view class="metric-label">今日营业额</view></view>
    <view class="metric"><view class="metric-value">{{dashboard.revenueDeltaText}}</view><view class="metric-label">较昨日营收</view></view>
    <view class="metric"><view class="metric-value">{{dashboard.todayOrderCount}}</view><view class="metric-label">今日订单</view></view>
    <view class="metric"><view class="metric-value">{{dashboard.orderCountDelta}}</view><view class="metric-label">较昨日订单</view></view>
    <view class="metric"><view class="metric-value">{{dashboard.memberCount}}</view><view class="metric-label">会员数</view></view>
    <view class="metric"><view class="metric-value">{{dashboard.newMemberDelta}}</view><view class="metric-label">较昨日新增</view></view>
    <view class="metric"><view class="metric-value">{{dashboard.tableUsageRate}}%</view><view class="metric-label">卡座使用率</view></view>
    <view class="metric"><view class="metric-value">{{dashboard.lowStockCount}}</view><view class="metric-label">低库存</view></view>
    <view class="metric"><view class="metric-value">{{dashboard.pendingOrderCount}}</view><view class="metric-label">待处理订单</view></view>
  </view>

  <view class="section">
    <view class="section-title">订单管理</view>
    <view class="row">
      <view class="row-title">订单转存表单</view>
      <picker range="{{products}}" range-key="name" value="{{transferForm.skuIndex}}" bindchange="onTransferSkuChange">
        <view class="input">{{products[transferForm.skuIndex].name || '选择转存 SKU'}}</view>
      </picker>
      <input class="input" type="number" value="{{transferForm.quantity}}" bindinput="onTransferQty" placeholder="转存数量" />
      <input class="input" value="{{operationForm.orderCompleteReason}}" data-field="orderCompleteReason" bindinput="onOperationReason" placeholder="订单完成原因" />
      <input class="input" value="{{operationForm.refundReason}}" data-field="refundReason" bindinput="onOperationReason" placeholder="退款原因" />
    </view>
    <view wx:if="{{orders.length === 0}}" class="muted">暂无订单。</view>
    <view wx:for="{{orders}}" wx:key="orderId" class="row">
      <view class="row-title">{{item.orderId}} · {{item.amountText}}</view>
      <view class="muted">{{item.statusText}} · {{item.employeeName}} · {{item.user.phone}}</view>
      <view class="muted">可转存：{{item.transferableText || '无可转存商品'}}</view>
      <view class="btn-row">
        <button size="mini" class="primary" data-id="{{item.orderId}}" bindtap="completeOrder">完成</button>
        <button size="mini" class="secondary" data-id="{{item.orderId}}" bindtap="refundOrder">退款</button>
        <button size="mini" class="secondary" data-id="{{item.orderId}}" bindtap="transferStorage">按表单转存</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">员工销售提成</view>
    <view wx:for="{{staffSales}}" wx:key="employeeId" class="row">
      <view class="row-title">{{item.name}} · {{item.salesText}}</view>
      <view class="muted">订单 {{item.orderCount}} 笔 · 提成 {{item.commissionText}} · 比例 {{item.commissionRateText}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">SKU 库存</view>
    <input class="input" value="{{productKeyword}}" bindinput="onProductKeyword" placeholder="按商品名/规格筛选" />
    <view class="btn-row">
      <button size="mini" class="secondary" bindtap="searchProducts">筛选</button>
    </view>
    <view class="row">
      <view class="row-title">商品分类表单</view>
      <input class="input" value="{{categoryForm.name}}" bindinput="onCategoryName" placeholder="分类名称" />
      <input class="input" type="number" value="{{categoryForm.sortOrder}}" bindinput="onCategorySortOrder" placeholder="排序值" />
      <button size="mini" class="secondary" bindtap="createCategory">新增分类</button>
    </view>
    <view wx:for="{{productCategories}}" wx:key="categoryId" class="row">
      <view class="row-title">{{item.name}}</view>
      <view class="muted">{{item.status}}</view>
      <button size="mini" class="secondary" data-id="{{item.categoryId}}" data-status="{{item.status}}" bindtap="toggleCategory">启停分类</button>
    </view>
    <picker range="{{productCategories}}" range-key="name" value="{{productForm.categoryIndex}}" bindchange="onProductCategoryChange">
      <view class="input">{{productCategories[productForm.categoryIndex].name || '选择分类'}}</view>
    </picker>
    <input class="input" value="{{productForm.name}}" bindinput="onProductName" placeholder="SKU 名称" />
    <input class="input" value="{{productForm.spec}}" bindinput="onProductSpec" placeholder="规格" />
    <input class="input" value="{{productForm.unit}}" bindinput="onProductUnit" placeholder="单位" />
    <input class="input" value="{{productForm.description}}" bindinput="onProductDescription" placeholder="商品描述" />
    <input class="input" type="number" value="{{productForm.price}}" bindinput="onProductPrice" placeholder="售价" />
    <input class="input" type="number" value="{{productForm.costPrice}}" bindinput="onProductCost" placeholder="成本价" />
    <input class="input" value="{{productForm.supplierName}}" bindinput="onProductSupplier" placeholder="供应商" />
    <input class="input" type="number" value="{{productForm.stockQty}}" bindinput="onProductStock" placeholder="初始库存" />
    <input class="input" type="number" value="{{productForm.warningQty}}" bindinput="onProductWarning" placeholder="预警库存" />
    <input class="input" type="number" value="{{productForm.storageDays}}" bindinput="onProductStorageDays" placeholder="存酒有效期天数" />
    <view class="muted">编辑 SKU：{{productForm.editingSkuId || '未选择'}}</view>
    <button size="mini" class="primary" bindtap="createProduct">新增 SKU</button>
    <button size="mini" class="secondary" bindtap="updateProduct">保存 SKU</button>
    <view class="row">
      <view class="row-title">库存盘点表单</view>
      <input class="input" type="number" value="{{stockCountForm.countedQty}}" bindinput="onStockCountQty" placeholder="实盘库存" />
      <input class="input" value="{{stockCountForm.reason}}" bindinput="onStockCountReason" placeholder="盘点原因" />
    </view>
    <view class="row">
      <view class="row-title">出入库申请表单</view>
      <input class="input" type="number" value="{{stockRequestForm.quantity}}" bindinput="onStockRequestQty" placeholder="出入库数量" />
      <input class="input" value="{{stockRequestForm.reason}}" bindinput="onStockRequestReason" placeholder="出入库原因" />
    </view>
    <view wx:for="{{products}}" wx:key="skuId" class="row">
      <view class="row-title">{{item.name}} · {{item.spec}}</view>
      <view class="muted">{{item.priceText}} · 成本 {{item.costPrice}} · {{item.supplierName || '未填供应商'}} · 库存 {{item.stockQty}} · 预警 {{item.warningQty}} · 存酒 {{item.storageDays}}天</view>
      <view class="btn-row">
        <button size="mini" class="secondary" data-id="{{item.skuId}}" bindtap="fillProductForm">填入编辑</button>
        <button size="mini" class="secondary" data-id="{{item.skuId}}" bindtap="addStock">创建盘点单</button>
        <button size="mini" class="secondary" data-id="{{item.skuId}}" data-direction="in" bindtap="createStockRequest">入库申请</button>
        <button size="mini" class="secondary" data-id="{{item.skuId}}" data-direction="out" bindtap="createStockRequest">出库申请</button>
        <button size="mini" class="secondary" data-id="{{item.skuId}}" data-status="{{item.status}}" bindtap="toggleProduct">上下架</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">两套账：库存与存酒</view>
    <view wx:for="{{stockRequests}}" wx:key="requestId" class="row">
      <view class="row-title">{{item.directionText}} · {{item.product.name}} x {{item.quantity}}</view>
      <view class="muted">{{item.statusText}} · {{item.reason}}</view>
      <view wx:if="{{item.status === 'pending'}}">
        <input class="input" value="{{operationForm.stockRejectReason}}" data-field="stockRejectReason" bindinput="onOperationReason" placeholder="驳回原因" />
        <input class="input" value="{{operationForm.stockCancelReason}}" data-field="stockCancelReason" bindinput="onOperationReason" placeholder="取消原因" />
      </view>
      <view wx:if="{{item.status === 'pending'}}" class="btn-row">
        <button size="mini" class="primary" data-id="{{item.requestId}}" bindtap="confirmStockRequest">确认入账</button>
        <button size="mini" class="secondary" data-id="{{item.requestId}}" bindtap="rejectStockRequest">驳回</button>
        <button size="mini" class="secondary" data-id="{{item.requestId}}" bindtap="cancelStockRequest">取消</button>
      </view>
    </view>
    <view class="row">
      <view class="row-title">库存盘点单</view>
      <view class="muted">记录 SKU 账面库存、实盘库存、盘盈盘亏。</view>
    </view>
    <view wx:for="{{stockCounts}}" wx:key="countId" class="row">
      <view class="row-title">{{item.product.name}} · 实盘 {{item.countedQty}}</view>
      <view class="muted">账面 {{item.bookQty}} · 差异 {{item.differenceQty}} · {{item.reason}}</view>
    </view>
    <view class="row">
      <view class="row-title">商家库存流水</view>
      <view class="muted">记录采购入库、销售扣减、退款恢复、盘点调整和出库。</view>
    </view>
    <view wx:for="{{stockLedgers}}" wx:key="ledgerId" class="row">
      <view class="row-title">{{item.product.name}} · {{item.changeType}}</view>
      <view class="muted">变动 {{item.changeQty}} · 库存 {{item.stockAfter}} · {{item.reason}}</view>
    </view>
    <view class="row">
      <view class="row-title">客户存酒流水</view>
      <view class="muted">记录订单转存、手工存酒、取酒核销和过期人工处理。</view>
    </view>
    <view wx:for="{{storageLedgers}}" wx:key="ledgerId" class="row">
      <view class="row-title">{{item.userPhone}} · {{item.productName}} · {{item.actionType}}</view>
      <view class="muted">变动 {{item.changeQty}} · 存酒余量 {{item.quantityAfter}} · {{item.reason}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">客户存酒</view>
    <view class="row">
      <view class="row-title">取酒申请队列</view>
      <view class="muted">管理员可查看客户申请、商品、数量、余量和处理状态。</view>
    </view>
    <view wx:if="{{pickupRequests.length === 0}}" class="muted">暂无取酒申请。</view>
    <view wx:for="{{pickupRequests}}" wx:key="requestId" class="row">
      <view class="row-title">{{item.userPhone}} · {{item.productName}}</view>
      <view class="muted">{{item.statusText}} · 申请 {{item.quantity}} · 存酒余量 {{item.storageQuantity}} · {{item.requestedAtText}} · {{item.requestId}}</view>
    </view>
    <view class="row">
      <view class="row-title">过期存酒处理表单</view>
      <picker range="{{operationForm.expiredStorageActionOptions}}" range-key="label" value="{{operationForm.expiredStorageActionIndex}}" bindchange="onExpiredStorageAction">
        <view class="input">处理动作：{{operationForm.expiredStorageActionOptions[operationForm.expiredStorageActionIndex].label}}</view>
      </picker>
      <input class="input" type="number" value="{{operationForm.expiredStorageExtendDays}}" data-field="expiredStorageExtendDays" bindinput="onOperationNumber" placeholder="延期天数" />
      <input class="input" value="{{operationForm.expiredStorageNote}}" data-field="expiredStorageNote" bindinput="onOperationReason" placeholder="处理备注" />
    </view>
    <view wx:for="{{storage}}" wx:key="storageId" class="row">
      <view class="row-title">{{item.user.phone}} · {{item.product.name}}</view>
      <view class="muted">{{item.statusText}} · 数量 {{item.quantity}} · 到期 {{item.expireDate}}</view>
      <button wx:if="{{item.status === 'expired'}}" size="mini" class="primary" data-id="{{item.storageId}}" bindtap="handleExpiredStorage">人工处理过期</button>
    </view>
  </view>

  <view class="section">
    <view class="section-title">预约管理</view>
    <view class="row">
      <view class="row-title">预约处理原因</view>
      <input class="input" value="{{operationForm.reservationConfirmReason}}" data-field="reservationConfirmReason" bindinput="onOperationReason" placeholder="确认原因" />
      <input class="input" value="{{operationForm.reservationCancelReason}}" data-field="reservationCancelReason" bindinput="onOperationReason" placeholder="取消原因" />
      <input class="input" value="{{operationForm.reservationExpireReason}}" data-field="reservationExpireReason" bindinput="onOperationReason" placeholder="失效原因" />
    </view>
    <view wx:if="{{reservations.length === 0}}" class="muted">暂无预约。</view>
    <view wx:for="{{reservations}}" wx:key="reservationId" class="row">
      <view class="row-title">{{item.table.name}} · {{item.user.phone}}</view>
      <view class="muted">{{item.statusText}} · {{item.reservationDate}} · {{item.partySize || 1}}人 · {{item.remark || '无备注'}}</view>
      <view wx:if="{{item.status === 'pending' || item.status === 'confirmed'}}" class="btn-row">
        <button wx:if="{{item.status === 'pending'}}" size="mini" class="primary" data-id="{{item.reservationId}}" bindtap="confirmReservation">确认预约</button>
        <button size="mini" class="secondary" data-id="{{item.reservationId}}" bindtap="cancelAdminReservation">取消预约</button>
        <button wx:if="{{item.status === 'pending'}}" size="mini" class="secondary" data-id="{{item.reservationId}}" bindtap="expireReservation">标记失效</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">咖位管理</view>
    <view class="metrics">
      <view class="metric"><view class="metric-value">{{tableSummary.total}}</view><view class="metric-label">总咖位</view></view>
      <view class="metric"><view class="metric-value">{{tableSummary.available}}</view><view class="metric-label">空闲</view></view>
      <view class="metric"><view class="metric-value">{{tableSummary.occupied}}</view><view class="metric-label">占用</view></view>
      <view class="metric"><view class="metric-value">{{tableSummary.reserved}}</view><view class="metric-label">预订</view></view>
      <view class="metric"><view class="metric-value">{{tableSummary.maintenance}}</view><view class="metric-label">维护</view></view>
    </view>
    <input class="input" value="{{tableKeyword}}" bindinput="onTableKeyword" placeholder="搜索桌台名称/类型" />
    <picker range="{{tableStatusOptions}}" range-key="label" value="{{tableStatusIndex}}" bindchange="onTableStatusChange">
      <view class="input">状态筛选：{{tableStatusOptions[tableStatusIndex].label}}</view>
    </picker>
    <view class="btn-row">
      <button size="mini" class="secondary" bindtap="searchTables">搜索咖位</button>
      <button size="mini" class="secondary" bindtap="prevTablePage">上一页</button>
      <button size="mini" class="secondary" bindtap="nextTablePage">下一页</button>
    </view>
    <view class="muted">第 {{tablePagination.page}} / {{tablePagination.pageCount}} 页 · 共 {{tablePagination.total}} 条</view>
    <input class="input" value="{{tableForm.name}}" bindinput="onTableName" placeholder="桌台名称" />
    <input class="input" type="number" value="{{tableForm.capacity}}" bindinput="onTableCapacity" placeholder="人数" />
    <input class="input" value="{{tableForm.imageUrl}}" bindinput="onTableImage" placeholder="桌台图片 URL" />
    <button size="mini" class="primary" bindtap="createTable">新增座台</button>
    <view class="row">
      <view class="row-title">开台占用表单</view>
      <input class="input" type="number" value="{{tableOccupyForm.consumptionAmount}}" bindinput="onTableOccupyAmount" placeholder="开台消费金额" />
      <input class="input" value="{{tableOccupyForm.reason}}" bindinput="onTableOccupyReason" placeholder="开台原因" />
      <input class="input" value="{{operationForm.tableMaintenanceReason}}" data-field="tableMaintenanceReason" bindinput="onOperationReason" placeholder="维护原因" />
      <input class="input" value="{{operationForm.tableDeleteReason}}" data-field="tableDeleteReason" bindinput="onOperationReason" placeholder="删除/禁用原因" />
    </view>
    <view wx:for="{{tables}}" wx:key="tableId" class="row">
      <view class="row-title">{{item.name}} · {{item.capacity}}人</view>
      <view class="muted">{{item.type}} · {{item.statusText}} · 消费 {{item.consumptionText}} · 图片 {{item.imageUrl ? '已配置' : '未配置'}}</view>
      <view class="btn-row">
        <button size="mini" class="secondary" data-id="{{item.tableId}}" bindtap="occupyTable">开台占用</button>
        <button size="mini" class="secondary" data-id="{{item.tableId}}" bindtap="disableTable">设为维护</button>
        <button size="mini" class="secondary" data-id="{{item.tableId}}" bindtap="deleteTable">删除/禁用</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">操作日志</view>
    <view wx:for="{{logs}}" wx:key="logId" class="row">
      <view class="row-title">{{item.operatorText}} · {{item.action}}</view>
      <view class="muted">{{item.role}} · {{item.targetText}} · {{item.reason}} · {{item.createdAt}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">财务与营业</view>
    <view class="metrics">
      <view class="metric"><view class="metric-value">{{finance.todayRevenueText}}</view><view class="metric-label">今日营收</view></view>
      <view class="metric"><view class="metric-value">{{finance.monthRevenueText}}</view><view class="metric-label">本月营收</view></view>
      <view class="metric"><view class="metric-value">{{finance.wechatPayRevenueText}}</view><view class="metric-label">微信支付营收</view></view>
      <view class="metric"><view class="metric-value">{{businessDetails.length}}</view><view class="metric-label">营业明细</view></view>
    </view>
    <view wx:for="{{consumptionRecords}}" wx:key="orderId" class="row">
      <view class="row-title">{{item.user.phone}} · {{item.amountText}}</view>
      <view class="muted">{{item.statusText}} · {{item.employee ? item.employee.name : '自然订单'}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">会员等级与积分配置</view>
    <view wx:for="{{users}}" wx:key="userId" class="row">
      <view class="row-title">{{item.phone}} · {{item.memberLevel}}</view>
      <view class="muted">积分 {{item.pointsBalance}} · 存酒 {{item.hasStorage ? item.storageCount : 0}} · 消费 {{item.totalSpendText}} · 订单 {{item.orderCount}}</view>
    </view>
    <view class="row">
      <view class="row-title">会员等级表单</view>
      <input class="input" value="{{memberLevelForm.name}}" bindinput="onMemberLevelName" placeholder="等级名称" />
      <input class="input" type="number" value="{{memberLevelForm.minPoints}}" bindinput="onMemberLevelMinPoints" placeholder="最低积分" />
      <button size="mini" class="secondary" bindtap="createMemberLevel">新增会员等级</button>
    </view>
    <view wx:for="{{memberLevels}}" wx:key="levelId" class="row">
      <view class="row-title">{{item.name}}</view>
      <view class="muted">最低积分 {{item.minPoints}} · {{item.status}}</view>
      <button size="mini" class="secondary" data-id="{{item.levelId}}" bindtap="disableMemberLevel">停用等级</button>
    </view>
    <view class="row">
      <view class="row-title">积分配置</view>
      <view class="muted">签到 {{pointsConfig.checkinPoints}} · 有效期 {{pointsConfig.pointExpireDays}}天 · 积分显示 {{pointsConfig.pointsVisible}} · 签到开关 {{pointsConfig.checkinEnabled}}</view>
      <input class="input" type="number" value="{{pointsConfigForm.checkinPoints}}" bindinput="onCheckinPoints" placeholder="签到赠送积分" />
      <input class="input" type="number" value="{{pointsConfigForm.pointExpireDays}}" bindinput="onPointExpireDays" placeholder="积分有效期天数" />
      <switch checked="{{pointsConfigForm.pointsVisible}}" bindchange="onPointsVisibleChange" /> 积分显示
      <switch checked="{{pointsConfigForm.checkinEnabled}}" bindchange="onCheckinEnabledChange" /> 签到启用
      <button size="mini" class="secondary" bindtap="updatePointsConfig">更新积分配置</button>
    </view>
    <view class="row">
      <view class="row-title">积分明细</view>
      <view class="muted">消费赠分、手动增减、扫码取积分均记录客户、变动、余额、原因和服务人员。</view>
    </view>
    <view wx:if="{{pointsLedgers.length === 0}}" class="muted">暂无积分明细。</view>
    <view wx:for="{{pointsLedgers}}" wx:key="ledgerId" class="row">
      <view class="row-title">{{item.userPhone}} · {{item.changeAmount}} 分</view>
      <view class="muted">余额 {{item.balanceAfter}} · {{item.reason}} · 服务人员 {{item.serviceEmployeeName}} · {{item.sourceText}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">人员与系统设置</view>
    <view class="row">
      <view class="row-title">新增员工表单</view>
      <input class="input" value="{{employeeForm.name}}" bindinput="onEmployeeName" placeholder="员工姓名" />
      <input class="input" value="{{employeeForm.phone}}" bindinput="onEmployeePhone" placeholder="员工手机号" />
      <input class="input" value="{{employeeForm.loginAccount}}" bindinput="onEmployeeLoginAccount" placeholder="登录账号" />
      <input class="input" password="true" value="{{employeeForm.password}}" bindinput="onEmployeePassword" placeholder="初始密码" />
      <input class="input" value="{{employeeForm.role}}" bindinput="onEmployeeRole" placeholder="角色 staff/dealer/warehouse" />
      <input class="input" type="digit" value="{{employeeForm.commissionRate}}" bindinput="onEmployeeCommissionRate" placeholder="提成率，如 0.05" />
      <button size="mini" class="primary" bindtap="createEmployee">新增员工</button>
    </view>
    <view class="row">
      <view class="row-title">系统设置</view>
      <view class="muted">积分显示 {{systemSettings.pointsVisible}} · 客服 {{systemSettings.supportPhone}} · 地址 {{systemSettings.location.address}}</view>
      <input class="input" value="{{systemSettingsForm.supportPhone}}" bindinput="onSystemSupportPhone" placeholder="客服电话" />
      <input class="input" value="{{systemSettingsForm.locationAddress}}" bindinput="onSystemLocationAddress" placeholder="门店地址" />
      <input class="input" type="digit" value="{{systemSettingsForm.latitude}}" bindinput="onSystemLatitude" placeholder="纬度" />
      <input class="input" type="digit" value="{{systemSettingsForm.longitude}}" bindinput="onSystemLongitude" placeholder="经度" />
      <switch checked="{{systemSettingsForm.pointsVisible}}" bindchange="onSystemPointsVisibleChange" /> 系统积分显示
      <button size="mini" class="secondary" bindtap="updateSystemSettings">保存系统设置</button>
    </view>
    <view class="row">
      <view class="row-title">升盲设置</view>
      <view class="muted">主题 {{blindSettings.theme}} · 字号 {{blindSettings.fontSize}} · 报名 {{blindSettings.registrationStatus}}</view>
      <input class="input" value="{{blindForm.theme}}" data-key="theme" bindinput="onBlindField" placeholder="主题风格" />
      <input class="input" value="{{blindForm.backgroundImage}}" data-key="backgroundImage" bindinput="onBlindField" placeholder="背景图 URL" />
      <input class="input" value="{{blindForm.logo}}" data-key="logo" bindinput="onBlindField" placeholder="Logo URL" />
      <input class="input" value="{{blindForm.championBackgroundImage}}" data-key="championBackgroundImage" bindinput="onBlindField" placeholder="冠军背景图 URL" />
      <input class="input" value="{{blindForm.fontColor}}" data-key="fontColor" bindinput="onBlindField" placeholder="字体颜色" />
      <input class="input" value="{{blindForm.timerColor}}" data-key="timerColor" bindinput="onBlindField" placeholder="计时颜色" />
      <input class="input" value="{{blindForm.breakColor}}" data-key="breakColor" bindinput="onBlindField" placeholder="休息颜色" />
      <input class="input" value="{{blindForm.dialogColor}}" data-key="dialogColor" bindinput="onBlindField" placeholder="弹窗颜色" />
      <input class="input" type="number" value="{{blindForm.fontSize}}" data-key="fontSize" bindinput="onBlindField" placeholder="字体大小" />
      <input class="input" value="{{blindForm.fontFamily}}" data-key="fontFamily" bindinput="onBlindField" placeholder="字体样式" />
      <input class="input" value="{{blindForm.registrationStatus}}" data-key="registrationStatus" bindinput="onBlindField" placeholder="报名状态" />
      <input class="input" type="number" value="{{blindForm.entrants}}" data-key="entrants" bindinput="onBlindField" placeholder="参赛人数" />
      <input class="input" type="number" value="{{blindForm.totalBuyins}}" data-key="totalBuyins" bindinput="onBlindField" placeholder="总买入手数" />
      <switch checked="{{blindForm.autoStartAfterCountdown}}" bindchange="onBlindAutoStartChange" /> 倒计时结束自动升盲
      <input class="input" value="{{blindForm.levelTitle}}" data-key="levelTitle" bindinput="onBlindField" placeholder="标题：级别" />
      <input class="input" value="{{blindForm.playerLeftTitle}}" data-key="playerLeftTitle" bindinput="onBlindField" placeholder="标题：剩余人数" />
      <input class="input" value="{{blindForm.blindsTitle}}" data-key="blindsTitle" bindinput="onBlindField" placeholder="标题：盲注" />
      <input class="input" value="{{blindForm.entrantsTitle}}" data-key="entrantsTitle" bindinput="onBlindField" placeholder="标题：参赛人数" />
      <input class="input" value="{{blindForm.blindLevelsText}}" data-key="blindLevelsText" bindinput="onBlindField" placeholder="升盲规则：1/2,2/4,5/10" />
      <input class="input" value="{{blindForm.voiceType}}" data-key="voiceType" bindinput="onBlindField" placeholder="语音类型" />
      <input class="input" value="{{blindForm.voiceStartText}}" data-key="voiceStartText" bindinput="onBlindField" placeholder="开始语音文案" />
      <input class="input" value="{{blindForm.voiceEndText}}" data-key="voiceEndText" bindinput="onBlindField" placeholder="结束语音文案" />
      <input class="input" value="{{blindForm.smallBlindTerm}}" data-key="smallBlindTerm" bindinput="onBlindField" placeholder="术语：小盲" />
      <input class="input" value="{{blindForm.bigBlindTerm}}" data-key="bigBlindTerm" bindinput="onBlindField" placeholder="术语：大盲" />
      <input class="input" value="{{blindForm.anteTerm}}" data-key="anteTerm" bindinput="onBlindField" placeholder="术语：前注" />
      <button size="mini" class="secondary" bindtap="updateBlindSettings">保存升盲设置</button>
    </view>
    <view wx:for="{{scanRecords}}" wx:key="recordId" class="row">
      <view class="row-title">扫码归属 {{item.employeeId}}</view>
      <view class="muted">{{item.rawCode}} · {{item.createdAt}}</view>
    </view>
  </view>
</view>
