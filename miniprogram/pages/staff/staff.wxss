.input {
  width: auto;
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.seat {
  border: 1rpx solid #d8ded6;
  border-radius: 12rpx;
  padding: 12rpx;
}

.qr-image {
  width: 320rpx;
  height: 320rpx;
  display: block;
  margin: 12rpx 0;
  border: 1rpx solid #d8ded6;
  border-radius: 8rpx;
  background: #ffffff;
}
