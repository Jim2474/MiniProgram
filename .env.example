APP_ENV=production
REQUIRE_AUTH=true

# Database for production/sandbox. Use sqlite://./backend/data/store.sqlite for single-node deployment.
DATABASE_URL=sqlite://./backend/data/store.sqlite
# Sandbox/demo only. Production without DATABASE_URL is blocked unless this is explicitly true.
ALLOW_JSON_STORE_IN_PRODUCTION=false

# WeChat Mini Program login and phone authorization.
WECHAT_APPID=
WECHAT_APP_SECRET=
# Sandbox/test only: when true, code login returns deterministic dry-run openid without calling WeChat.
WECHAT_LOGIN_DRY_RUN=false
# Sandbox/test only: when true, phone authorization code returns deterministic dry-run phone without calling WeChat.
WECHAT_PHONE_DRY_RUN=false
# Sandbox/test only: when true, employee order QR returns a deterministic mini program code dry-run image.
WECHAT_QR_DRY_RUN=false
WECHAT_MINIPROGRAM_ENV_VERSION=release

# WeChat Pay JSAPI.
WECHAT_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATE=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://example.com/api/payments/wechat/notify
# Sandbox/test only: when true, backend signs local requestPayment params without creating a real WeChat prepay order.
WECHAT_PAY_DRY_RUN=false
