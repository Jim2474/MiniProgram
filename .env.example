APP_ENV=production
REQUIRE_AUTH=true

# Database planned for production. Leave unset for local JSON store demos.
DATABASE_URL=

# WeChat Mini Program login and phone authorization.
WECHAT_APPID=
WECHAT_APP_SECRET=
# Sandbox/test only: when true, code login returns deterministic dry-run openid without calling WeChat.
WECHAT_LOGIN_DRY_RUN=false

# WeChat Pay JSAPI.
WECHAT_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATE=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://example.com/api/payments/wechat/notify
# Sandbox/test only: when true, backend signs local requestPayment params without creating a real WeChat prepay order.
WECHAT_PAY_DRY_RUN=false
